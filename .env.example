# Copy this file to ".env" (same folder) and fill in your values.
# PowerShell:  Copy-Item .env.example .env

# --- MySQL connection ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=expense_analyzer

# --- Flask ---
# Backend port (5001 avoids the macOS AirPlay Receiver, which uses 5000).
# If you change it, also change the proxy target in frontend/vite.config.js.
FLASK_PORT=5001

# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Set to true only when serving over HTTPS
SESSION_COOKIE_SECURE=false

# Allows the "Load demo data" button in Settings (sample data for presentations)
ENABLE_DEMO_SEED=true
